# --- ntfy (push notifications, no account needed) ---
# The shared topic subscribers listen to. Treat this like a shared secret:
# anyone who knows it can subscribe to (or publish to) it.
NTFY_TOPIC=ddbb-dodgers-panda-win

# ntfy server to publish to. Default is the free public ntfy.sh; point this
# at your own instance if you self-host.
NTFY_SERVER=https://ntfy.sh

# --- App config ---
# Port the web server listens on
PORT=3000

# Base URL where this app is publicly reachable (used in logs).
# e.g. https://dodgers-alerts.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# MLB team id for the Dodgers (don't change unless you're forking this for another team)
MLB_TEAM_ID=119

# How often to check for a finished Dodgers game, in cron syntax. Default: every 5 minutes.
CHECK_CRON=*/5 * * * *

# When to send the next-morning recap text for last night's home win(s), cron syntax + timezone.
# Default: 8:00 AM Pacific (Dodger Stadium's home timezone).
MORNING_CRON=0 8 * * *
MORNING_TZ=America/Los_Angeles

# Substring (case-insensitive) that must appear in the game's venue name for it to
# count as a "home game" worth notifying about. Matches "UNIQLO Field at Dodger Stadium"
# (the venue's current sponsored name) as well as a plain "Dodger Stadium".
HOME_VENUE_MATCH=dodger stadium

# Optional: shared secret to protect the /admin endpoints (test notification).
ADMIN_SECRET=change_me_to_something_random
